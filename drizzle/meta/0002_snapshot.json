  "views": {
    "public.post_ranks": {
      "columns": {
        "post_id": {
          "name": "post_id",
          "type": "uuid",
          "primaryKey": false,
          "notNull": true
        },
        "rank": {
          "name": "rank",
          "type": "bigint",
          "primaryKey": false,
          "notNull": true
        },
        "totw_number": {
          "name": "totw_number",
          "type": "bigint",
          "primaryKey": false,
          "notNull": true
        },
        "totw_position": {
          "name": "totw_position",
          "type": "bigint",
          "primaryKey": false,
          "notNull": true
        }
      },
      "definition": "\n  SELECT\n    id AS post_id,\n    ROW_NUMBER() OVER (ORDER BY published_at, id) AS rank,\n    ((ROW_NUMBER() OVER (ORDER BY published_at, id) - 1) / 15) + 1 AS totw_number,\n    ((ROW_NUMBER() OVER (ORDER BY published_at, id) - 1) % 15) + 1 AS totw_position\n  FROM posts\n  WHERE status = 'published'\n",
      "name": "post_ranks",
      "schema": "public",
      "isExisting": false,
      "materialized": false
    }
  },
