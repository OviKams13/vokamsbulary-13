# Vokamsbulary 13 — environment variables
# Copy to .env.local and fill in the values. Never commit .env.local.
# All of these are server-only: never prefix them with NEXT_PUBLIC_.

# Neon Postgres (2.7). Local and Vercel Preview use the `dev` branch,
# Vercel Production uses the `main` branch.
# Pooled connection, used by the app:
DATABASE_URL=
# Direct (unpooled) connection, used only by drizzle-kit for migrations:
DATABASE_URL_UNPOOLED=

# Vercel Blob (2.9, required from 6.4). Local and Vercel Preview use the dev store
# through its token. Vercel Production uses the prod store through OIDC: it sets
# BLOB_STORE_ID itself, and BLOB_READ_WRITE_TOKEN stays unset there.
BLOB_READ_WRITE_TOKEN=

# Claude API key from the Claude Console (2.10)
ANTHROPIC_API_KEY=

# Access code typed once per device, any length (3.1)
ACCESS_CODE=
# Secret that signs the access cookie: at least 32 random characters (3.1).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it (or ACCESS_CODE) signs every device out.
ACCESS_COOKIE_SECRET=
